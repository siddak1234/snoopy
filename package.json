{
  "name": "snoopy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:boundaries": "node scripts/audit-boundaries.mjs",
    "test:contracts": "node --experimental-strip-types --test test/*.test.mjs",
    "format": "prettier --write .",
