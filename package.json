{
  "name": "snoopy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:boundaries": "node scripts/audit-boundaries.mjs",
    "test:contracts": "node --experimental-strip-types --test test/*.test.mjs",
    "generate:platform-contracts": "node scripts/generate-platform-contracts.mjs",
    "verify:platform-contracts": "node scripts/verify-platform-contracts.mjs",
    "test:visual": "playwright test e2e/marketing.visual.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:browser": "playwright test",
    "test:browser:fixtures": "node scripts/run-browser-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^12.38.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.1.18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
