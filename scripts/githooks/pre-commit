#!/bin/sh
# Native pre-commit gate: every commit of this public repository runs the kit's
# private-data scan on the staged content (a client's name, real contact
# details: AGENTS.md rule 9) and is refused on a finding (exit 1) or when the
# scan cannot run (any other non-zero exit), so private data never reaches
# history. The pre-push hook and CI run the same scan.
# Installed via `npm run hooks:install` (bash scripts/install-git-hooks.sh:
# git config core.hooksPath scripts/githooks).

cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -f scripts/kit/private-data-scan.mjs ]; then
  echo "pre-commit: the kit's private-data scan is missing from this clone — refused." >&2
  exit 1
fi
node scripts/kit/private-data-scan.mjs --staged </dev/null >&2
status=$?
if [ "$status" -eq 1 ]; then
  echo "pre-commit: the private-data scan found private data in the staged content — refused. Replace it with a reserved value (AGENTS.md rule 9)." >&2
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "pre-commit: the private-data scan could not run (exit $status) — refused; it never fails open." >&2
  exit 1
fi
exit 0
