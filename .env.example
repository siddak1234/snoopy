# Copy to .env.local and fill in. Never commit .env.local.
# The website receives only the backend origin in the target architecture.
# Supabase URL, keys, database credentials, object-store credentials, provider
# secrets, and execution credentials belong to backend-managed secret storage.
BACKEND_API_ORIGIN=http://localhost:8080

# Transitional legacy database settings. Current server-rendered project,
# workspace, workflow, and membership code still imports Prisma. Do not point
# these variables at the new Supabase project. Remove them from Vercel only
# after the Access and Automation Catalog API cutover checkpoint passes.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
