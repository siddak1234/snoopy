# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# .claude/* (not .claude/) so the negations below can re-include files:
# git never descends into a directory excluded as a whole.
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/agents/
!.claude/skills/

# macOS/iCloud Finder conflict copies ("file 2.tsx") — never commit these
* 2.*
* 2/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (do not commit real secrets; .env.example is the committed template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Recovered client data. `_salvage/` holds the n8n workflow export and the legacy
# database archive: real customer email addresses, vendor names, and dollar
# amounts. It belongs in encrypted storage, not in git — history is permanent, so
# deleting the file later does not undo the commit. CI fails if one is tracked.
_salvage/
